# Separate gateway environment. Never commit the real .env file.
PORT=8090
DRUNIX_GATEWAY_TOKEN=replace_with_a_long_random_secret

# Remote network values: replace every placeholder with the actual DRUNIX test-network values.
# This Node gateway runs without Docker; it connects to a peer that is already running elsewhere.
DRUNIX_PEER_ENDPOINT=replace-with-network-peer-host:7051
DRUNIX_PEER_HOST_ALIAS=peer0.org1.example.com
DRUNIX_TLS_CERT_PATH=/absolute/path/to/peer-tls-ca.pem
DRUNIX_IDENTITY_CERT_PATH=/absolute/path/to/org1-client-cert.pem
DRUNIX_IDENTITY_KEY_PATH=/absolute/path/to/org1-client-key.pem
DRUNIX_MSP_ID=Org1MSP
DRUNIX_CHANNEL=your-channel-name
DRUNIX_CHAINCODE=cardsaathi
