# Copy to .env and add your newly generated key locally. Never commit or share .env.
LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_your_rotated_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional local Hugging Face inference, after you train/download a LoRA adapter:
# LLM_PROVIDER=local_hf
# HF_BASE_MODEL=Qwen/Qwen3-1.7B
# HF_ADAPTER_PATH=models/cardsaathi-qwen3-1.7b-lora

# Application-handoff ledger. demo = local SQLite simulation (NOT blockchain).
DRUNIX_MODE=demo
# To use a separately deployed DRUNIX gateway, switch to drunix and set both:
# DRUNIX_MODE=drunix
# DRUNIX_GATEWAY_URL=http://127.0.0.1:8090
# DRUNIX_GATEWAY_TOKEN=use_a_separate_long_random_token
# Optional live issuer workflow: a SECOND gateway configured with Org2 credentials.
# Do not point this at the Org1 gateway or reuse the Org1 gateway token.
# DRUNIX_ISSUER_GATEWAY_URL=http://127.0.0.1:8091
# DRUNIX_ISSUER_GATEWAY_TOKEN=use_a_different_long_random_token_for_org2
# Protects the issuer actions exposed by this local prototype; set a strong random value.
# DRUNIX_ISSUER_CONSOLE_TOKEN=use_another_long_random_secret
# Spring Boot auth (JWT). Must be at least 32 characters; generate with: openssl rand -base64 48
FINORA_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Optional: use an external database instead of the local H2 file
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finora
# SPRING_DATASOURCE_USERNAME=finora
# SPRING_DATASOURCE_PASSWORD=change_me
