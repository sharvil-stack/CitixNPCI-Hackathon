# ---- Frontend (browser) ----
# Leave unset to use the built-in same-origin proxy (/svc/<name>), which Vite forwards to the targets below.
# Set these only if you serve the built app from a host that proxies the services itself, or if the
# services send CORS headers for your origin (CardWise and Spring Boot do not by default).
# VITE_CARDWISE_URL=http://127.0.0.1:8000
# VITE_SCHEMES_URL=http://127.0.0.1:8001
# VITE_STUDY_URL=http://127.0.0.1:8002
# VITE_SCAM_URL=http://127.0.0.1:8080

# ---- Dev-server proxy targets (read by vite.config.ts, never shipped to the browser) ----
CARDWISE_URL=http://127.0.0.1:8000
SCHEMES_URL=http://127.0.0.1:8001
STUDY_URL=http://127.0.0.1:8002
SCAM_URL=http://127.0.0.1:8080
# Accounts (login/signup) live in the Spring Boot app; defaults to the same /svc/scam proxy
# VITE_AUTH_URL=http://localhost:8080
